# ── Server ───────────────────────────────────────────────────
PORT=3000

# Public URL of your server (used in verification email links)
# Local dev:   http://localhost:3000
# Production:  http://YOUR_EC2_PUBLIC_IP  or  https://yourdomain.com
APP_URL=http://localhost:3000

# ── Security ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# ── PostgreSQL ───────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local:      postgresql://catuser:yourpassword@localhost:5432/catlobby
DATABASE_URL=postgresql://catuser:yourpassword@localhost:5432/catlobby

# Set to true if using SSL (e.g. RDS, Supabase). Leave false for local EC2 Postgres.
DB_SSL=false

# ── Redis ────────────────────────────────────────────────────
# Used for session/rate limiting (optional — app runs without it)
# Local: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── Email (SMTP) ─────────────────────────────────────────────
# Option 1 — Gmail App Password (easiest for testing)
#   1. Enable 2-Step Verification on your Google account
#   2. Generate an App Password at myaccount.google.com → Security → App Passwords
#
# Option 2 — Any SMTP provider (SendGrid, Mailgun, SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="Cat Lobby <your_gmail@gmail.com>"
